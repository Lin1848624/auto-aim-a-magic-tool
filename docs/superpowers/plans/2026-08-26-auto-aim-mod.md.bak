**Files:**
- Create: `src/main/java/com/autoaim/client/gui/ConfigScreen.java`

**Interfaces:**
- Consumes: `Config`（8 个 ConfigValue + 缓存字段 + `refresh/save`）
- Produces: `class ConfigScreen extends Screen`，构造 `ConfigScreen(Screen parent)` 与 `ConfigScreen()`

- [ ] **Step 1: 实现**

`src/main/java/com/autoaim/client/gui/ConfigScreen.java`：

```java
package com.autoaim.client.gui;

import com.autoaim.Config;
import net.minecraft.client.gui.GuiGraphics;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.chat.Component;
import net.minecraftforge.common.ForgeConfigSpec;

import java.util.ArrayList;
import java.util.List;

/** 简易配置界面：每行一个设置 + -/+ 或 开/关；改动即时生效，关闭写盘。 */
public class ConfigScreen extends Screen {
    private final Screen parent;
    private final List<Row> rows = new ArrayList<>();

    public ConfigScreen(Screen parent) {
        super(Component.literal("Auto-Aim 设置"));
        this.parent = parent;
        rows.add(new NumRow(Config.DISPLAY_RANGE, "显示范围（格）", 8, 128, 4, 24));
        rows.add(new NumRow(Config.LOCK_RANGE, "锁定范围（格）", 8, 128, 4, 24));
        rows.add(new NumRow(Config.LOCK_ANGLE, "准星容差角（度）", 1, 60, 1, 15.0));
        rows.add(new NumRow(Config.AIM_SPEED, "瞄准速度", 0.02, 1.0, 0.02, 0.25));
        rows.add(new BoolRow(Config.TARGET_HOSTILES_ONLY, "仅锁定敌对生物", false));
        rows.add(new BoolRow(Config.INCLUDE_PLAYERS, "包含玩家", false));
        rows.add(new BoolRow(Config.SHOW_LOCKED_TARGET, "锁定目标高亮", true));
        rows.add(new BoolRow(Config.SHOW_TRAJECTORY, "显示弹道轨迹", true));
    }

    public ConfigScreen() { this(null); }

    @Override
    protected void init() {
        int left = this.width / 2 - 150;
        int right = this.width / 2 + 150;
        int y = 32;
        for (Row row : rows) {
            row.y = y;
            row.build(this, left, right);
            y += 26;
        }
        this.addRenderableWidget(Button.builder(Component.literal("保存"), b -> {
            Config.refresh();
            Config.save();
        }).bounds(left, y + 10, 96, 20).build());
        this.addRenderableWidget(Button.builder(Component.literal("恢复默认"), b -> {
            for (Row r : rows) r.reset();
            Config.refresh();
            Config.save();
        }).bounds(left + 102, y + 10, 96, 20).build());
        this.addRenderableWidget(Button.builder(Component.literal("关闭"), b -> onClose())
                .bounds(right - 96, y + 10, 96, 20).build());
    }

    @Override
    public void render(GuiGraphics g, int mx, int my, float partialTick) {
        this.renderBackground(g);
        g.drawCenteredString(this.font, this.title, this.width / 2, 12, 0xFFFFFF);
        for (Row r : rows) r.render(g, this.width / 2 - 138);
        super.render(g, mx, my, partialTick);
    }

    @Override
    public void onClose() {
        this.minecraft.setScreen(this.parent);
    }

    @Override
    public boolean isPauseScreen() { return false; }

    private abstract static class Row {
        final ForgeConfigSpec.ConfigValue<?> value;
        final String label;
        final Object defaultValue;
        int y;

        Row(ForgeConfigSpec.ConfigValue<?> value, String label, Object defaultValue) {
            this.value = value;
            this.label = label;
            this.defaultValue = defaultValue;
        }

        abstract void build(ConfigScreen screen, int left, int right);
        abstract void reset();
        abstract String currentText();

        void render(GuiGraphics g, int x) {
            g.drawString(this.font(), label, x, y, 0xFFFFFF);
            g.drawCenteredString(this.font(), currentText(), x + 132, y, 0xCCCCCC);
        }

        net.minecraft.client.gui.Font font() { return net.minecraft.client.Minecraft.getInstance().font; }
    }

    private static class NumRow extends Row {
        final double min, max, step;
        Button minus, plus;

        NumRow(ForgeConfigSpec.ConfigValue<?> value, String label, double min, double max, double step, Object defaultValue) {
            super(value, label, defaultValue);
            this.min = min;
            this.max = max;
            this.step = step;
        }

        @Override
        void build(ConfigScreen screen, int left, int right) {
            minus = Button.builder(Component.literal("-"), b -> adjust(-step))
                    .bounds(left, y, 20, 20).build();
            plus = Button.builder(Component.literal("+"), b -> adjust(step))
                    .bounds(right - 20, y, 20, 20).build();
            screen.addRenderableWidget(minus);
            screen.addRenderableWidget(plus);
        }

        void adjust(double delta) {
            if (value instanceof ForgeConfigSpec.IntValue iv) {
                int nv = (int) Math.max(min, Math.min(max, iv.get() + (delta > 0 ? step : -step)));
                iv.set(nv);
            } else if (value instanceof ForgeConfigSpec.DoubleValue dv) {
                double nv = Math.max(min, Math.min(max, Math.round((dv.get() + delta) * 100.0) / 100.0));
                dv.set(nv);
            }
        }

        @Override
        void reset() {
            if (value instanceof ForgeConfigSpec.IntValue iv) iv.set((Integer) defaultValue);
            else if (value instanceof ForgeConfigSpec.DoubleValue dv) dv.set(((Number) defaultValue).doubleValue());
        }

        @Override
        String currentText() {
            return value instanceof ForgeConfigSpec.IntValue iv ? String.valueOf(iv.get())
                    : String.valueOf(Math.round(((ForgeConfigSpec.DoubleValue) value).get() * 100.0) / 100.0);
        }
    }

    private static class BoolRow extends Row {
        Button toggle;

        BoolRow(ForgeConfigSpec.ConfigValue<?> value, String label, boolean defaultValue) {
            super(value, label, defaultValue);
        }

        @Override
        void build(ConfigScreen screen, int left, int right) {
            toggle = Button.builder(Component.literal(currentText()), b -> {
                ((ForgeConfigSpec.BooleanValue) value).set(!((ForgeConfigSpec.BooleanValue) value).get());
                b.setMessage(Component.literal(currentText()));
            }).bounds(right - 60, y, 60, 20).build();
            screen.addRenderableWidget(toggle);
        }

        @Override
        void reset() {
            ((ForgeConfigSpec.BooleanValue) value).set((Boolean) defaultValue);
        }

        @Override
        String currentText() {
            return ((ForgeConfigSpec.BooleanValue) value).get() ? "开" : "关";
        }
    }
}
```

